# Приложение читает окружение процесса; .env автоматически не загружается.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYSIS_STORAGE_DIR=out/api

# Единственный AI-провайдер: OpenAI Responses API.
# Ключ и доступное аккаунту имя модели задайте в окружении; значения здесь намеренно пусты.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
